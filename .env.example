# Create a LinkedIn Developer app and enable:
# - Sign In with LinkedIn using OpenID Connect
# - Share on LinkedIn (w_member_social)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Set a currently supported LinkedIn REST API version (YYYYMM)
LINKEDIN_API_VERSION=202608
# Optional: private local data folder, NEVER inside your Git repository
# LINKEDIN_MCP_HOME=/absolute/private/path
